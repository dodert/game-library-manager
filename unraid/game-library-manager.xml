<?xml version="1.0"?>
<Container version="2">
  <Name>game-library-manager</Name>
  <Repository>ghcr.io/dodert/game-library-manager:latest</Repository>
  <Registry>https://github.com/dodert/game-library-manager/pkgs/container/game-library-manager</Registry>
  <Network>bridge</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/dodert/game-library-manager/issues</Support>
  <Project>https://github.com/dodert/game-library-manager</Project>
  <Overview>Self-hosted video game collection manager (physical and digital, every console and PC) with cover art and metadata from IGDB, SteamGridDB, Steam and ScreenScraper. SQLite by default, PostgreSQL optional.</Overview>
  <Category>MediaApp:Other Tools:</Category>
  <Icon>https://raw.githubusercontent.com/dodert/unraid-templates/main/icon.png</Icon>
  <DonateLink>https://ko-fi.com/dodert</DonateLink>
  <DonateText>Support development on Ko-fi</DonateText>
  <WebUI>http://[IP]:[PORT:8000]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/dodert/unraid-templates/main/game-library-manager.xml</TemplateURL>
  <Config Name="WebUI port" Target="8000" Default="8000" Mode="tcp" Description="Web interface port" Type="Port" Display="always" Required="true" Mask="false">8000</Config>
  <Config Name="Data" Target="/data" Default="/mnt/user/appdata/game-library-manager" Mode="rw" Description="Database and covers" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/game-library-manager</Config>
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Description="User id the app runs as" Type="Variable" Display="advanced" Required="false" Mask="false">99</Config>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Description="Group id the app runs as" Type="Variable" Display="advanced" Required="false" Mask="false">100</Config>
  <Config Name="TZ" Target="TZ" Default="Europe/Madrid" Mode="" Description="Time zone" Type="Variable" Display="advanced" Required="false" Mask="false">Europe/Madrid</Config>
  <Config Name="DATABASE_URL" Target="DATABASE_URL" Default="" Mode="" Description="Optional. Empty = SQLite in /data. PostgreSQL: postgresql+psycopg://user:pass@host:5432/games" Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="IGDB client id" Target="IGDB_CLIENT_ID" Default="" Mode="" Description="From https://dev.twitch.tv/console" Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="IGDB client secret" Target="IGDB_CLIENT_SECRET" Default="" Mode="" Description="From https://dev.twitch.tv/console" Type="Variable" Display="always" Required="false" Mask="true"/>
  <Config Name="SteamGridDB API key" Target="STEAMGRIDDB_API_KEY" Default="" Mode="" Description="From https://www.steamgriddb.com/profile/preferences/api" Type="Variable" Display="always" Required="false" Mask="true"/>
  <Config Name="Steam API key" Target="STEAM_API_KEY" Default="" Mode="" Description="From https://steamcommunity.com/dev/apikey (library import)" Type="Variable" Display="always" Required="false" Mask="true"/>
  <Config Name="Steam ID" Target="STEAM_ID" Default="" Mode="" Description="Your SteamID64 (library import)" Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="ScreenScraper dev id" Target="SCREENSCRAPER_DEV_ID" Default="" Mode="" Description="ScreenScraper developer credentials" Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="ScreenScraper dev password" Target="SCREENSCRAPER_DEV_PASSWORD" Default="" Mode="" Description="ScreenScraper developer credentials" Type="Variable" Display="always" Required="false" Mask="true"/>
  <Config Name="ScreenScraper user" Target="SCREENSCRAPER_USER" Default="" Mode="" Description="Your screenscraper.fr account" Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="ScreenScraper password" Target="SCREENSCRAPER_PASSWORD" Default="" Mode="" Description="Your screenscraper.fr account" Type="Variable" Display="always" Required="false" Mask="true"/>
  <Config Name="Login user" Target="AUTH_USERNAME" Default="" Mode="" Description="User for the login screen. Set it together with the password; leave both empty for no login" Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="Login password" Target="AUTH_PASSWORD" Default="" Mode="" Description="Password for the login screen. Changing it logs everyone out" Type="Variable" Display="always" Required="false" Mask="true"/>
</Container>
